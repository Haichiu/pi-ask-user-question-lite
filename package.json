  "description": "A minimal, timeout-free AskUserQuestion tool for Pi with TUI, RPC, and headless support.",
  "type": "module",
  "license": "MIT",
  "author": "haichiu",
  "contributors": [
    {
      "name": "Pi Coding Agent",
      "url": "https://pi.dev"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haichiu/pi-ask-user-question-lite.git"
  },
  "homepage": "https://github.com/haichiu/pi-ask-user-question-lite#readme",
  "bugs": {
    "url": "https://github.com/haichiu/pi-ask-user-question-lite/issues"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "ask-user-question",
    "human-in-the-loop",
    "tui",
    "rpc"
  ],
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
